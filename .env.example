# --- PostgreSQL ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=portal_bonos
POSTGRES_PORT=5432
# Used by dbmate, the API and the worker. Must match the values above when running via docker-compose.
DATABASE_URL=postgres://portal:change-me-strong-password@db:5432/portal_bonos?sslmode=disable

# --- API / worker ---
NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info
# 32-byte key, base64-encoded, used for AES-256-GCM encryption of integration credentials.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Random 64+ char string used to sign access/refresh JWTs. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed origins for the API's CORS policy.
CORS_ORIGIN=http://localhost:8080
# Shared secret Google must send in the X-Webhook-Secret header. Leave empty only while discovering the payload.
# Generate with: openssl rand -hex 24
SECRET_TOKEN=

# --- Web (nginx) ---
WEB_PORT=8080

# --- Seed (fase 1) ---
SEED_ADMIN_EMAIL=admin@portal.local
SEED_ADMIN_PASSWORD=ChangeMe123!
